{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/instructions.md"
  ],
  "mcp": {
    "graphify": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "graphifyy",
        "serve"
      ],
      "enabled": true
    },
    "medium-reader": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-medium-reader",
        "serve"
      ],
      "enabled": true
    }
  }
}
